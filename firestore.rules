rules_version = '2';

// ===============================================================
// Multi-App Firestore Security Rules
// Project: antigravity-init-512109
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // App 1: Existing App (2-word sync codes)
    // ===============================================================
    // Each profile document is named after its 2-word code (e.g. /profiles/mellow-tiger)
    match /profiles/{syncCode} {
      // Allow reading and writing only if the user specifies the direct document code
      allow get: if true;
      allow create, update: if true;

      // Prohibit listing/querying the entire collection so sync codes cannot be enumerated
      allow list: if false;
    }

    // ===============================================================
    // App 2: By Heart (Song Lyrics & Chord Progression Memorization)
    // Collection: byheart_profiles/{profileId}
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOAuthProfile(profileId) {
      return profileId.matches('^oauth_.*');
    }

    function isOAuthOwner(profileId) {
      return isAuthenticated() && profileId == 'oauth_' + request.auth.uid;
    }

    function isValidProfileId(profileId) {
      return profileId is string &&
             profileId.size() >= 1 &&
             profileId.size() <= 150 &&
             profileId != '.' &&
             profileId != '..' &&
             !profileId.matches('^__.*__$') &&
             !profileId.matches('.*[/\\\\].*') &&
             !profileId.matches('.*[\\n\\r\\t].*');
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isAuthorizedUserId(data) {
      return !('userId' in data) || (isAuthenticated() && data.userId == request.auth.uid);
    }

    function isValidProfile(data, profileId) {
      return hasRequiredFields(['username', 'songs', 'themeId', 'updatedAt']) &&
             hasOnlyAllowedFields(['username', 'songs', 'themeId', 'updatedAt', 'authProvider', 'userId']) &&
             data.username is string &&
             data.username.size() >= 1 &&
             data.username.size() <= 100 &&
             data.songs is list &&
             data.songs.size() <= 200 &&
             data.themeId is string &&
             data.themeId.size() >= 1 &&
             data.themeId.size() <= 50 &&
             ((data.updatedAt is timestamp) || (data.updatedAt is number && data.updatedAt > 0)) &&
             (!('authProvider' in data) ||
              (data.authProvider is string &&
               data.authProvider in ['anonymous', 'google', 'apple', 'username'])) &&
             (!('userId' in data) ||
              (data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128)) &&
             (!isOAuthProfile(profileId) || !('userId' in data) || (isAuthenticated() && data.userId == request.auth.uid));
    }

    match /byheart_profiles/{profileId} {
      // Username profiles are public to read; OAuth profiles are private to the owner
      allow read: if isValidProfileId(profileId) &&
                     (!isOAuthProfile(profileId) || isOAuthOwner(profileId));

      // Create new profile with schema and identity checks
      allow create: if isValidProfileId(profileId) &&
                       isValidProfile(request.resource.data, profileId) &&
                       (!isOAuthProfile(profileId) || isOAuthOwner(profileId)) &&
                       isAuthorizedUserId(request.resource.data);

      // Updates require schema validity and owner checks
      allow update: if isValidProfileId(profileId) &&
                       isValidProfile(request.resource.data, profileId) &&
                       (!isOAuthProfile(profileId) || isOAuthOwner(profileId)) &&
                       (!('userId' in resource.data) || (isAuthenticated() && resource.data.userId == request.auth.uid)) &&
                       (!('userId' in resource.data) || ('userId' in request.resource.data && request.resource.data.userId == resource.data.userId)) &&
                       isAuthorizedUserId(request.resource.data);

      // Deletions allowed only for OAuth owners of their own profile
      allow delete: if isValidProfileId(profileId) &&
                       isOAuthProfile(profileId) &&
                       isOAuthOwner(profileId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
